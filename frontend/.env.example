# Frontend settings. Nothing here is secret: every VITE_ value is built into the page.
# Copy to .env.local to change them. `npm run dev:mocks` uses .env.mocks instead.

# "true" answers every API call from the mock API (src/mocks), so no backend is needed.
# Demo login on mocks: demo@insureintel.test / demo-password-1
VITE_USE_MOCKS=false

# Gateway origin. Leave empty in development: the Vite proxy forwards /api and /health
# to http://127.0.0.1:8000.
VITE_API_BASE_URL=
