# .gitignore

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# --- Type checkers / linters ---
.mypy_cache/
.ruff_cache/
.pytype/

# --- Project data (real policy documents must never be committed) ---
data/sample_policies/*
!data/sample_policies/.gitkeep
!data/sample_policies/README.md
data/processed/*
!data/processed/.gitkeep
data/uploads/

# --- Frontend ---
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
.npm/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/
