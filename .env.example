# .env.example
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# LLM provider: Google Gemini via the `google-genai` package
# ---------------------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey and put it in your local
# `.env` only. Leave it empty here. If it is missing, the LLM client raises a
# clear configuration error instead of calling the API.
GEMINI_API_KEY=
# Any Gemini model ID your key can use (see https://ai.google.dev/gemini-api/docs/models)
LLM_MODEL=gemini-3.5-flash
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
# Per-call timeout, and how many times to retry temporary failures
# (rate limits, server errors, timeouts).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Agent service endpoints (used by the orchestration pipeline)
# ---------------------------------------------------------------------------
RISK_AGENT_URL=http://localhost:8001
POLICY_AGENT_URL=http://localhost:8002
COVERAGE_AGENT_URL=http://localhost:8003
EXPLANATION_AGENT_URL=http://localhost:8004

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Storage paths
# ---------------------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/sample_policies
PROCESSED_DIR=./data/processed
VECTOR_STORE_DIR=./data/processed/vector_store

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Shared secret required in the `X-API-Key` header for every agent endpoint.
INTERNAL_API_KEY=change-me-in-production
REDACT_PII=true
MAX_UPLOAD_MB=25
