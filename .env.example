# .env.example
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Agent service endpoints (used by the orchestration pipeline)
# ---------------------------------------------------------------------------
RISK_AGENT_URL=http://localhost:8001
POLICY_AGENT_URL=http://localhost:8002
COVERAGE_AGENT_URL=http://localhost:8003
EXPLANATION_AGENT_URL=http://localhost:8004

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Storage paths
# ---------------------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/sample_policies
PROCESSED_DIR=./data/processed
VECTOR_STORE_DIR=./data/processed/vector_store

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Shared secret required in the `X-API-Key` header for every agent endpoint.
INTERNAL_API_KEY=change-me-in-production
REDACT_PII=true
MAX_UPLOAD_MB=25
