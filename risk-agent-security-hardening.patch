--- a/agents/risk_agent/tests/test_llm_enricher.py
+++ b/agents/risk_agent/tests/test_llm_enricher.py
@@ -287,3 +287,36 @@
         parse_response("TOPSECRET-BAD-OUTPUT {", BAKERY_IDS)
